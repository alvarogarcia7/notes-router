{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "nats.router/message/1.0",
  "title": "NATS Router Message Schema",
  "description": "Base schema for all NATS messages - defines the structure that all messages must comply with",
  "type": "object",
  "required": ["id", "producer", "schema", "payload"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique message identifier (UUID)",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "description": "Producer identifier in format: com.application.name/version",
      "pattern": "^[a-z0-9./-]+$",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "description": "Schema reference in format: com.application.name/messageType/version",
      "pattern": "^[a-z0-9./-]+$",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "Message payload container with message content and metadata",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string",
          "description": "The actual message content"
        },
        "status": {
          "type": "string",
          "enum": ["PROCESSED", "PENDING", "FAILED"],
          "description": "Message processing status (optional, for responses)"
        },
        "counter": {
          "type": "integer",
          "minimum": 0,
          "description": "Message sequence counter (optional, for responses)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
