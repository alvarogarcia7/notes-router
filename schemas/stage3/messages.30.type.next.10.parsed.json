{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Next Entry Parsed Result",
  "description": "Parsed next entry message (messages.30.type.next.10.parsed topic)",
  "type": "object",
  "required": ["id", "title", "content", "source", "type", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the message"
    },
    "title": {
      "type": "string",
      "description": "Next action or goal title"
    },
    "content": {
      "type": "string",
      "description": "Parsed next entry details"
    },
    "source": {
      "type": "string",
      "enum": ["googlenotes", "applenotes"],
      "description": "Original source"
    },
    "type": {
      "type": "string",
      "enum": ["next"],
      "description": "Message type"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Original message timestamp"
    },
    "parsed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when message was parsed"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed"],
      "description": "Parsed or inferred status"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Extracted or inferred priority"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Extracted due date if present"
    }
  }
}
