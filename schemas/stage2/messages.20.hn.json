{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HackerNews Routed Message",
  "description": "Message routed to HackerNews parser (messages.20.hn topic)",
  "type": "object",
  "required": ["id", "title", "content", "source", "type", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the message"
    },
    "title": {
      "type": "string",
      "description": "Link title or article headline"
    },
    "content": {
      "type": "string",
      "description": "Link, article, or content body"
    },
    "source": {
      "type": "string",
      "enum": ["googlenotes", "applenotes"],
      "description": "Original source of the message"
    },
    "type": {
      "type": "string",
      "enum": ["hn"],
      "description": "Detected message type"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of original message"
    }
  }
}
