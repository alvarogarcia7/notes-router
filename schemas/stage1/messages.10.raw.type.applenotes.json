{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apple Notes Raw Message",
  "description": "Raw message from Apple Notes via notes-exporter publisher",
  "type": "object",
  "required": ["id", "title", "content", "source", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the message"
    },
    "title": {
      "type": "string",
      "description": "Note title from Apple Notes"
    },
    "content": {
      "type": "string",
      "description": "Note content body"
    },
    "source": {
      "type": "string",
      "enum": ["applenotes"],
      "description": "Source identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when message was published"
    },
    "folder": {
      "type": "string",
      "description": "Optional folder path in Apple Notes"
    }
  }
}
